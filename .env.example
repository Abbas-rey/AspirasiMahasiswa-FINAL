# Database Connection (PostgreSQL 18 with Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/asma_uin?schema=public"

# JWT Secret Key (Must be at least 32 characters, randomly generated)
JWT_SECRET="replace_with_a_secure_random_at_least_32_characters_secret_key"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
